              "x-absolute-tolerance": 0.001,
              "description": "Subtract persisted_record.accepted_at from updated_at. Use seconds, rounded to three decimal places; absolute tolerance 0.001 seconds."
            },
            "worker_span_seconds": {
              "type": "number",
              "minimum": 0,
              "x-absolute-tolerance": 0.001,
              "description": "Convert coldline.process_exception duration from Jaeger microseconds. Use seconds, rounded to three decimal places; absolute tolerance 0.001 seconds."
            },
            "model_span_seconds": {
              "type": "number",
              "minimum": 0,
              "x-absolute-tolerance": 0.001,
              "description": "Convert model_provider.summarize duration from Jaeger microseconds. Use seconds, rounded to three decimal places; absolute tolerance 0.001 seconds."
